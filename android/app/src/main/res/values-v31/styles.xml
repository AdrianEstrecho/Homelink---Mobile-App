<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ owns the cold-start splash screen via its own SplashScreen API,
         which reads these dedicated attributes instead of the plain android:background
         used pre API 31; without this override the OS falls back to a neutral
         background behind the launcher icon instead of the brand navy. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0f2b5b</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
